# Jarvis Recon Kit - the ONE env template. Copy to .env (gitignored). No values here.
# LoRa frame HMAC key - REQUIRED (bridge refuses to start, firmware build fails without it; >=16 chars).
# Same value in watch-firmware/secrets.ini as -DJV_LORA_KEY
JV_LORA_KEY=
JV_LORA_MODE=CUSTOM
JV_LORA_COM=COM5
JV_FLIPPER_COM=COM6
# MESHTASTIC mode only: allowlisted watch node ID(s), e.g. !a1b2c3d4 (mode disabled if empty)
JV_MESH_ALLOW_NODES=
# Shared secret for 127.0.0.1:8766/push (bridge + recon_ingest), >=24 chars. Header X-JV-Push-Token.
JV_PUSH_TOKEN=
# Bridge's own token to laptop-ingest (must also be listed in JV_INGEST_TOKENS)
JV_INGEST_TOKEN=
# No-tools orchestrator route for radio text. /recon is NOT YET in orchestrator.py (HgX). Never /jarvis.
JV_RECON_ROUTE=/recon
JV_FLIPPER_CATALOG_ROUTE=/catalog
# MediaMTX (PKG-1). laptop-ingest\start-mediamtx.ps1 REFUSES to start if any is empty, equals CHANGE_VIA_ENV,
# or a password/passphrase is < 24 random chars (3+ char classes, 12+ distinct). Publisher/reader must differ.
# publisher = glasses/phone bridge, reader = recon_ingest (localhost)
MTX_AUTHINTERNALUSERS_0_USER=
MTX_AUTHINTERNALUSERS_0_PASS=
MTX_AUTHINTERNALUSERS_1_USER=
MTX_AUTHINTERNALUSERS_1_PASS=
# SRT publish passphrase for path glasses (24-79 chars)
MTX_PATHS_GLASSES_SRTPUBLISHPASSPHRASE=
# Optional extra publisher hosts beyond tailnet 100.64.0.0/10 - specific /32 only, never a /24
MTX_AUTHINTERNALUSERS_0_IPS=
JV_MTX_READ_USER=
JV_MTX_READ_PASS=
# recon_ingest
JV_INGEST_BIND=127.0.0.1
JV_INGEST_PORT=8767
JV_VISION_MODEL=moondream:1.8b
# phone-bridge: see phone-bridge/.env.example
# The ONE cloud path (REA -> Cloud Jarvis compute). OFF by default; HgX approval required.
JV_CLOUD_JARVIS_ENABLED=false
# Per-device ingest tokens (iPhone, iPad, watch-relay), comma separated. Store copies in iOS Keychain only.
JV_INGEST_TOKENS=

# Mentra app-server cloud control (PKG-8) - OPT-IN, OFF by default. Default phone path = iOS Bluetooth SDK (PKG-14).
JV_MENTRA_APPSERVER_ENABLED=false
MENTRA_API_KEY=
# Cloud compute (snapshots only, never streams). OFF until SAF clears it.
JV_CLOUD_SNAPSHOTS_ONLY=true


