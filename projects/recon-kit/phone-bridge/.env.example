# Copy to .env and fill in. NEVER commit .env. (See also ../.env.example)
PACKAGE_NAME=com.hgx.jarvis.recon
MENTRAOS_API_KEY=
PORT=3000
# Glasses publish target = laptop LAN IP + MediaMTX publish creds. Pick one:
INGEST_URL=
#   rtmp://<laptop-lan-ip>:1935/glasses?user=<pub-user>&pass=<pub-pass>
#   srt://<laptop-lan-ip>:8890?streamid=publish:glasses:<pub-user>:<pub-pass>
#   http://<laptop-lan-ip>:8889/glasses/whip   (Basic auth)
INGEST_API=http://127.0.0.1:8767
# Endpoint selection via GET /health, in order: LAN, then Tailscale, then cloud (stub, disabled).
INGEST_API_LAN=
#   http://<laptop-lan-ip>:8767   (LAN bind needs approval)
INGEST_API_TAILSCALE=
#   http://<laptop-tailscale-100.x-ip>:8767
JV_CLOUD_JARVIS_ENABLED=false
STREAM_FPS=15
AUTO_STOP_SEC=30
# Per-device token matching one entry in laptop JV_INGEST_TOKENS
INGEST_TOKEN=
